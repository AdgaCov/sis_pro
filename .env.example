# Copie este archivo como .env y complete los valores.
# desarrollo | produccion
APP_CONFIG=desarrollo

# Genere una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie-esto

# Cree la base antes de migrar:
#   CREATE DATABASE seguimiento_mre CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/seguimiento_mre?charset=utf8mb4

# 1 cuando el sitio se sirve por HTTPS
SESSION_COOKIE_SECURE=0

# Opcional: ruta a LibreOffice para generar PDF
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Opcional: carpeta de archivos (adjuntos, plantillas, temporales). Por defecto ./storage
# STORAGE_DIR=D:\seguimiento_mre\storage

FLASK_APP=run.py
